{
  "name": "zed-agent-usage-title-tracker",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "author": "Ortwin Van der Stappen",
  "description": "ACP proxy that shows agent plan usage (rolling + weekly) in the Zed agent thread title",
  "type": "module",
  "scripts": {
    "usage": "node usage.mjs",
    "usage:codex": "node usage.mjs codex",
    "test": "node test/run.mjs",
    "test:real": "node test/real.mjs",
    "test:real:codex": "node test/real.mjs codex",
    "shim": "node scripts/install-shim.mjs",
    "shim:status": "node scripts/install-shim.mjs --status",
    "shim:uninstall": "node scripts/install-shim.mjs --uninstall"
  }
}
